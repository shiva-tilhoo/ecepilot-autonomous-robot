<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_description</name>
  <version>0.0.1</version>
  <description>Vehicle URDF models and 3D assets for LIDAR visualization</description>
  <maintainer email="357001243+shiva-tilhoo@users.noreply.github.com">Shiva Tilhoo</maintainer>
  <author>Mathéo Léon</author>
  <author>Amandine Soyez</author>
  <author>Shiva Tilhoo</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
